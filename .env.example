# Rodar localmente: cp .env.example .env && docker compose up -d db && pnpm dev
# Depois abra http://localhost:3000 (site) e http://localhost:3000/admin (painel da equipe).
# Gere um PAYLOAD_SECRET forte com: openssl rand -hex 32

DATABASE_URI=postgres://paraiso:paraiso_dev@127.0.0.1:5432/paraiso
PAYLOAD_SECRET=change-me-32-bytes-min
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
SITE_ENV=development
AGE_GATE_PROVIDER=self-declaration
TZ=America/Sao_Paulo
