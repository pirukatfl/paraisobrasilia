# Test environment (vitest + playwright). Copy to .env.test (ignored by git).
# Points ONLY at the isolated test database paraiso_test — resetDatabase refuses any other DB.
DATABASE_URI=postgres://paraiso:paraiso_dev@127.0.0.1:5432/paraiso_test
PAYLOAD_SECRET=test-secret-at-least-32-characters-long
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
SITE_ENV=staging
NEXT_PUBLIC_AGE_GATE_PROVIDER=self-declaration
TZ=America/Sao_Paulo
# Optional: staff password used by e2e (test DB only)
# E2E_STAFF_PASSWORD=senha-de-teste-123
# Optional: use a preinstalled Chromium instead of `playwright install` (e.g. /opt/pw-browsers/chromium)
# PW_CHROMIUM_PATH=
