# Staging — copie para .env.staging NO SERVIDOR (nunca no repositório) e preencha.
# scripts/deploy/bootstrap-vps.sh cria este arquivo sozinho, com segredos gerados no servidor.
# Gerar segredos à mão:  openssl rand -hex 24   (senha do banco)
#                        openssl rand -hex 32   (PAYLOAD_SECRET)

# Banco (container `db`, sem porta publicada). docker-compose.staging*.yml monta a
# DATABASE_URI a partir de POSTGRES_PASSWORD; a linha abaixo fica só como referência.
POSTGRES_PASSWORD=
DATABASE_URI=postgres://paraiso:${POSTGRES_PASSWORD}@db:5432/paraiso

PAYLOAD_SECRET=

# Endereço público do staging. Precisa ser igual ao usado no build da imagem
# (build arg NEXT_PUBLIC_SERVER_URL / variável STAGING_URL do GitHub).
NEXT_PUBLIC_SERVER_URL=https://novo.swingbrasilia.com.br
STAGING_DOMAIN=novo.swingbrasilia.com.br

SITE_ENV=staging
AGE_GATE_PROVIDER=self-declaration
NEXT_PUBLIC_AGE_GATE_PROVIDER=self-declaration
TZ=America/Sao_Paulo

# Fotos/flyers ficam no disco do servidor, no volume Docker `media` (decisão do cliente 2026-10-17).
MEDIA_DIR=/app/media

# Só para o modo GHCR (docker-compose.staging.ghcr.yml): imagem e tag a usar.
# GHCR_IMAGE=ghcr.io/dono/paraiso-site
# IMAGE_TAG=staging
